{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM"],
		"types": ["node"]
	},
	"include": ["client/*/src", "vitest.config.ts"],
	"exclude": ["client/*/dist"]
}
